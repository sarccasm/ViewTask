@model ShoppingCartViewModel
@{ ViewData["Title"] = "Order confirmation"; }
<p>Your products will be shipped at: @Model.Address. Bon appetite, @Model.FullName!</p>
<p>Supermarket: @Model.Supermarket</p>
<p>Shipping date: @Model.ShippingDate?.ToString("MM/dd/yyyy")</p>
<p>Products: @string.Join(", ", Model.Products)</p>
<a asp-action="ShoppingCart">Back to shopping cart</a>
